# 优先运行 scripts/prepare-local.ps1 生成 .env；若手工复制，必须替换所有 CHANGE_ME 值。
# MySQL 密码仅允许 16～128 位字母、数字及 _@%+=:,.-，以便初始化脚本安全传递。
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
IDENTITY_APP_PASSWORD=CHANGE_ME_identity_app_password
IDENTITY_MIGRATOR_PASSWORD=CHANGE_ME_identity_migrator_password
TRADE_APP_PASSWORD=CHANGE_ME_trade_app_password
TRADE_MIGRATOR_PASSWORD=CHANGE_ME_trade_migrator_password
PAYMENT_APP_PASSWORD=CHANGE_ME_payment_app_password
PAYMENT_MIGRATOR_PASSWORD=CHANGE_ME_payment_migrator_password

REDIS_PASSWORD=CHANGE_ME_redis_password
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# Nacos 3.2 首次启动后由 bootstrap.ps1 幂等初始化管理员密码。
NACOS_ADMIN_PASSWORD=CHANGE_ME_nacos_admin_password
# 四个服务只能使用 runtime 账号，不得使用管理员账号。
NACOS_RUNTIME_USERNAME=linkverse_mvp_runtime
NACOS_RUNTIME_PASSWORD=CHANGE_ME_nacos_runtime_password
# 必须是至少 32 个随机字节的 Base64 编码，不是普通明文口令。
NACOS_AUTH_TOKEN=CHANGE_ME_base64_token
NACOS_AUTH_IDENTITY_KEY=CHANGE_ME_nacos_identity_key
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_nacos_identity_value

# Java 服务的本地运行别名；prepare-local.ps1 会保证它们与上方基础设施凭据使用同一随机值。
LINKVERSE_IDENTITY_DB_USERNAME=linkverse_mvp_identity_app
LINKVERSE_IDENTITY_DB_PASSWORD=CHANGE_ME_identity_app_password
LINKVERSE_IDENTITY_FLYWAY_USERNAME=linkverse_mvp_identity_migrator
LINKVERSE_IDENTITY_FLYWAY_PASSWORD=CHANGE_ME_identity_migrator_password
TRADE_DB_USERNAME=linkverse_mvp_trade_app
TRADE_DB_PASSWORD=CHANGE_ME_trade_app_password
TRADE_FLYWAY_USERNAME=linkverse_mvp_trade_migrator
TRADE_FLYWAY_PASSWORD=CHANGE_ME_trade_migrator_password
PAYMENT_DB_USERNAME=linkverse_mvp_payment_app
PAYMENT_DB_PASSWORD=CHANGE_ME_payment_app_password
PAYMENT_FLYWAY_USERNAME=linkverse_mvp_payment_migrator
PAYMENT_FLYWAY_PASSWORD=CHANGE_ME_payment_migrator_password
RABBITMQ_USERNAME=linkverse_mvp_app

# Identity 本地签发材料与 Trade 服务客户端凭据。
LINKVERSE_JWT_KEY_ID=CHANGE_ME_local_key_id
LINKVERSE_JWT_PRIVATE_KEY=CHANGE_ME_file_uri_to_identity_private_pem
LINKVERSE_JWT_PUBLIC_KEY=CHANGE_ME_file_uri_to_identity_public_pem
LINKVERSE_TRADE_CLIENT_BOOTSTRAP_ENABLED=true
LINKVERSE_TRADE_CLIENT_SECRET=CHANGE_ME_trade_oauth_client_secret
TRADE_OAUTH_CLIENT_SECRET=CHANGE_ME_trade_oauth_client_secret
