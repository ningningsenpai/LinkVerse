# Docker Compose 项目标识与固定宿主端口
COMPOSE_PROJECT_NAME=linkverse-mvp
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
RABBITMQ_AMQP_HOST_PORT=15673
RABBITMQ_MANAGEMENT_HOST_PORT=15674
NACOS_CONSOLE_HOST_PORT=18090
NACOS_SERVER_HOST_PORT=18848
NACOS_GRPC_HOST_PORT=19848

# 阶段 1 已冻结的镜像标签
MYSQL_IMAGE=mysql:8.4.11
REDIS_IMAGE=redis:8.2.8
RABBITMQ_IMAGE=rabbitmq:4.3.4-management
NACOS_IMAGE=nacos/nacos-server:v3.2.3

# 2026-08-19 通过 Docker Engine 拉取冻结标签后核验的多架构清单摘要。
MYSQL_IMAGE_DIGEST=sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb
REDIS_IMAGE_DIGEST=sha256:2f7462b9e93e0a7ae2edf3a0a0babc8a4d29f8bfc50849b906b7caaef925edc1
RABBITMQ_IMAGE_DIGEST=sha256:eb5295d083325da5929a5ade766684d4019ffd2bce8bc7e43d6f9a05cafc8646
NACOS_IMAGE_DIGEST=sha256:059ca6313125c9ec43854d87d10b0d52fbbe86e595afad89b04da3ad5e2a3fde

# 业务数据库与六个最小权限账号
IDENTITY_DB_NAME=linkverse_mvp_identity
IDENTITY_APP_USER=linkverse_mvp_identity_app
IDENTITY_MIGRATOR_USER=linkverse_mvp_identity_migrator
TRADE_DB_NAME=linkverse_mvp_trade
TRADE_APP_USER=linkverse_mvp_trade_app
TRADE_MIGRATOR_USER=linkverse_mvp_trade_migrator
PAYMENT_DB_NAME=linkverse_mvp_payment
PAYMENT_APP_USER=linkverse_mvp_payment_app
PAYMENT_MIGRATOR_USER=linkverse_mvp_payment_migrator

# 中间件隔离命名
RABBITMQ_USER=linkverse_mvp_app
RABBITMQ_VHOST=linkverse-mvp
NACOS_ADMIN_USERNAME=nacos
NACOS_RUNTIME_ROLE=linkverse_mvp_runtime
NACOS_NAMESPACE=linkverse-mvp
NACOS_GROUP=LINKVERSE_MVP
REDIS_KEY_PREFIX=lv:mvp:{domain}:
